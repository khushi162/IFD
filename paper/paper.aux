\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Ablation study: final-round AUC-ROC. Full TRAP{} is Pareto-optimal across all four conditions. Removing Layer~3 yields a degenerate AUC=0.808 under SignFlip~20\% (all-benign collapse; see Fig.~\ref {fig_ablation_recall}).}}{9}{figure.9}\protected@file@percent }
\newlabel{fig_ablation_auc}{{9}{9}{Ablation study: final-round AUC-ROC. Full \sysname {} is Pareto-optimal across all four conditions. Removing Layer~3 yields a degenerate AUC=0.808 under SignFlip~20\% (all-benign collapse; see Fig.~\ref {fig_ablation_recall})}{figure.9}{}}
