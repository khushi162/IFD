\newlabel{fig_signflip}{{2}{5}{AUC-ROC under Sign-Flip attack. FedAvg collapses at 20\% and 40\% (final AUC=0.807/0.717 with Recall=0---all-benign collapse). TRAP is the only method that maintains non-zero F1 across all three ratios}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces AUC-ROC under Label-Flip attack. Krum catastrophically fails at 40\% (AUC=0.413, Recall=0.920, Precision=0.034---all-fraud collapse). TRAP and FedAvg remain partially functional, with TRAP achieving the highest F1 in all scenarios.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig_labelflip}{{3}{5}{AUC-ROC under Label-Flip attack. Krum catastrophically fails at 40\% (AUC=0.413, Recall=0.920, Precision=0.034---all-fraud collapse). TRAP and FedAvg remain partially functional, with TRAP achieving the highest F1 in all scenarios}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces AUC-ROC under Model-Replacement ($\gamma {=}10$). TRAP's Layer~1 norm filter neutralises scaled updates; TRAP achieves higher AUC than FedAvg at all three ratios. Krum shows higher AUC on this attack but inferior F1.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig_modelreplace}{{4}{5}{AUC-ROC under Model-Replacement ($\gamma {=}10$). TRAP's Layer~1 norm filter neutralises scaled updates; TRAP achieves higher AUC than FedAvg at all three ratios. Krum shows higher AUC on this attack but inferior F1}{figure.4}{}}
